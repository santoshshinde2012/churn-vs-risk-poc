# ---------------------------------------------------------------------------
# Generated by this repo
# ---------------------------------------------------------------------------
# Everything under outputs/ is rebuilt from scratch by `python run_all.py`,
# which deletes the directory first. Nothing in it is a source of truth: the
# figures the README displays are committed copies under docs/images/, and the
# console transcript is committed at docs/sample_run.txt.
outputs/

# The default MLflow locations, in case anyone runs mlflow from the repo root
# rather than through churnrisk/registry.py (which writes to outputs/mlruns).
mlruns/
mlartifacts/
.mlflow/

# Serialised models, wherever they land. The ones this repo produces live under
# outputs/ and are already covered; this catches a stray dump at the root.
*.joblib
*.pkl
*.pickle
*.h5
*.onnx

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging artifacts. This project is not distributed, but `pip install -e .`
# or a stray `python -m build` would produce these.
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
MANIFEST

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
# setup.sh creates .venv/. The others are here because people have habits.
.venv/
venv/
env/
ENV/
.python-version
pyvenv.cfg

# ---------------------------------------------------------------------------
