# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.pytype/
.tox/
.nox/
.cache/
.hypothesis/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb
.jupyter/
profile_default/
ipython_config.py

# Note: part_a_metrics.ipynb is committed WITH its outputs, on purpose. It is
# meant to be readable on GitHub without running anything, and the README
# quotes its numbers. Do not add nbstripout or an *.ipynb rule here without
# updating the docs and docs/claims.yaml to match.

# ---------------------------------------------------------------------------
# Credentials and local configuration
# ---------------------------------------------------------------------------
# part_b_databricks.py reads a host and a token. Neither belongs in git, and
# neither is needed to run anything in this repo locally.
.env
.env.*
!.env.example
.databrickscfg
.databricks/
*.pem
*.key
secrets.yaml
secrets.yml
credentials.json

